      </TABLE>
    </TD></TR>
    </TABLE>>];
      "orders":f0 -> "products":f0 [style=invis, weight=100, color=red]
    "orders":f2:e -> "products":f1:w [dir=forward, penwidth=3, color="#29235c", headlabel="1", taillabel="*"]
"inventory":f0 -> "products":f0 [style=invis, weight=100, color=red]
    "inventory":f2:e -> "products":f1:w [dir=forward, penwidth=3, color="#29235c", headlabel="1", taillabel="*"]
      
    }
