      </TABLE>
    </TD></TR>
<TR><TD ALIGN="LEFT" PORT="f3" BGCOLOR="#e7e2dd">
      <TABLE CELLPADDING="0" CELLSPACING="0" BORDER="0">
        <TR>
          <TD ALIGN="LEFT">total_amount    </TD>
          <TD ALIGN="RIGHT"><FONT><I>decimal</I> <B>(!)</B></FONT></TD>
