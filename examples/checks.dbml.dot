          <TD ALIGN="LEFT">hire_date    </TD>
          <TD ALIGN="RIGHT"><FONT><I>date</I> <B>(!)</B></FONT></TD>
        </TR>
      </TABLE>
    </TD></TR>
<TR><TD ALIGN="LEFT" PORT="f7" BGCOLOR="#e7e2dd">
      <TABLE CELLPADDING="0" CELLSPACING="0" BORDER="0">
        <TR>
          <TD ALIGN="LEFT">termination_date    </TD>
